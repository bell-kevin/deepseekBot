# Server-only secret. Never prefix this with VITE_.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# Optional production hardening. Use the exact public site origin.
# ALLOWED_ORIGIN=https://your-site.bolt.host

# Optional client endpoint override. Bolt/Supabase projects normally do not need it.
# VITE_CHAT_ENDPOINT=https://your-project.supabase.co/functions/v1/chat
